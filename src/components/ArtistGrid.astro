---
const artists = [
  {
    id: 1,
    name: "Martín González",
    role: "Pintor",
    bio: "Especializado en abstracionismo contemporáneo",
    image: "martin-gonzalez",
    works: 3
  },
  {
    id: 2,
    name: "Laura Fernández",
    role: "Escultora",
    bio: "Escultura que desafía la gravedad",
    image: "laura-fernandez",
    works: 2
  },
  {
    id: 3,
    name: "Carlos Ruiz",
    role: "Fotógrafo",
    bio: "Fotografía documental y composición",
    image: "carlos-ruiz",
    works: 2
  },
  {
    id: 4,
    name: "Ana Morales",
    role: "Artista Digital",
    bio: "Arte digital y realidad aumentada",
    image: "ana-morales",
    works: 2
  }
];

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/artists/*.jpg',
  { eager: true }
);

const getImage = (filename: string) => {
  const path = `/src/assets/images/artists/${filename}.jpg`;
  return imageModules[path]?.default?.src || null;
};
---

<div class="artists-grid">
  {artists.map((artist) => (
    <a href={`/artista/${artist.id}`} class="artist-card">
      <div class="artist-image">
        <img 
          src={getImage(artist.image)}
          alt={artist.name}
          loading="lazy"
        />
      </div>
      <div class="artist-info">
        <h3>{artist.name}</h3>
        <p class="role">{artist.role}</p>
        <p class="bio">{artist.bio}</p>
        <p class="works">{artist.works} obras</p>
      </div>
    </a>
  ))}
</div>

<style>
  .artists-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-lg);
  }

  .artist-card {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s;
    cursor: pointer;
  }

  .artist-card:hover {
    opacity: 0.8;
  }

  .artist-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 4px;
    margin-bottom: var(--spacing-md);
    background: var(--bg-light);
  }

  .artist-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .artist-card:hover .artist-image img {
    transform: scale(1.05);
  }

  .artist-info h3 {
    font-size: 1.1rem;
    margin-bottom: var(--spacing-xs);
    font-weight: 600;
  }

  .role {
    font-size: 0.85rem;
    color: var(--text-light);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--spacing-sm);
    font-weight: 500;
  }

  .bio {
    font-size: 0.85rem;
    color: var(--text-light);
    margin-bottom: var(--spacing-sm);
  }

  .works {
    font-size: 0.8rem;
    color: var(--text-lighter);
    margin: 0;
  }

  @media (max-width: 768px) {
    .artists-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--spacing-md);
    }
  }
</style>