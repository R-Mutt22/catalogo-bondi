---
interface Props {
  id: number;
}

const { id } = Astro.props;
---

<div class="like-button-wrapper" data-id={id}>
  <button class="like-btn" data-id={id} aria-label="Me gusta">
    <span class="heart-icon">♡</span>
  </button>
  <span class="like-count" data-id={id}>0</span>
</div>

<script>
  function initLikeButton() {
    const buttons = document.querySelectorAll('.like-btn');
    
    buttons.forEach(btn => {
      const id = btn.getAttribute('data-id');
      if (!id) return;
      
      const counter = document.querySelector(`.like-count[data-id="${id}"]`);
      if (!counter) return;
      
      // Cargar count guardado
      const savedCount = localStorage.getItem(`likes-count-${id}`);
      if (savedCount) {
        counter.textContent = savedCount;
      }
      
      // Verificar si ya dio like
      if (localStorage.getItem(`liked-${id}`)) {
        btn.classList.add('liked');
      }
      
      // Click handler
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        const isLiked = btn.classList.contains('liked');
        let count = parseInt(counter.textContent || '0');
        
        if (isLiked) {
          // Remover like
          btn.classList.remove('liked');
          count = Math.max(0, count - 1);
          localStorage.removeItem(`liked-${id}`);
        } else {
          // Agregar like
          btn.classList.add('liked');
          count++;
          localStorage.setItem(`liked-${id}`, 'true');
        }
        
        counter.textContent = count.toString();
        localStorage.setItem(`likes-count-${id}`, count.toString());
        
        // Toast
        showToast(isLiked ? 'Removido de favoritos' : '¡Agregado a favoritos!');
      });
    });
  }
  
  function showToast(msg: string) {
    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.textContent = msg;
    document.body.appendChild(toast);
    setTimeout(() => toast.classList.add('show'), 10);
    setTimeout(() => {
      toast.classList.remove('show');
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }
  
  // Inicializar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLikeButton);
  } else {
    initLikeButton();
  }
</script>

<style>
  .like-button-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .like-btn {
    width: 50px;
    height: 50px;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .like-btn:hover {
    border-color: white;
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }

  .heart-icon {
    font-size: 1.5rem;
    color: white;
    transition: all 0.3s ease;
  }

  .like-btn.liked {
    border-color: #ff6b6b;
    background: rgba(255, 107, 107, 0.3);
  }

  .like-btn.liked .heart-icon {
    color: #ff6b6b;
    font-size: 1.6rem;
  }

  .like-count {
    color: white;
    font-weight: 600;
    font-size: 1.1rem;
    min-width: 30px;
    text-align: center;
  }

  @media (max-width: 768px) {
    .like-btn {
      width: 45px;
      height: 45px;
    }

    .heart-icon {
      font-size: 1.3rem;
    }

    .like-count {
      font-size: 1rem;
    }
  }
</style>

<style is:global>
  .toast {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: rgba(0, 0, 0, 0.9);
    color: white;
    padding: 0.75rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    z-index: 2000;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .toast.show {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .toast {
      left: 10px;
      right: 10px;
      bottom: 10px;
    }
  }
</style>