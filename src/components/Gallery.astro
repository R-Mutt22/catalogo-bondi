---
import LikeButton from '../components/LikeButton.astro';
import ShareButton from '../components/ShareButton.astro';
import artworksData from '../data/artworks.json';

interface Artwork {
  id: number;
  title: string;
  artist: string;
  category: string;
  price: string;
  imageFile: string;
  thumbFile: string;
  description: string;
  availability: string;
  featured: boolean;
}

const artworks: Artwork[] = artworksData.artworks as Artwork[];
---

<section id="catalogo" class="gallery">
  <div class="gallery-container">
    <div class="gallery-header">
      <h1>Catálogo</h1>
      <input 
        type="text" 
        class="search-input" 
        placeholder="Buscar obra..."
        id="search-input"
      />
    </div>

    <div class="gallery-grid" id="gallery-grid">
      {artworks.map((artwork) => (
        <div 
          class="artwork-card" 
          data-id={artwork.id}
          data-title={artwork.title.toLowerCase()}
          data-artist={artwork.artist.toLowerCase()}
        >
          <a href={`/obra/${artwork.id}`} class="artwork-link">
            <div class="artwork-image-wrapper">
              <img 
                src={`/images/artworks/thumbnails/${artwork.thumbFile}.webp`}
                alt={artwork.title}
                loading="lazy"
              />
              
              <div class="overlay">
                <div class="overlay-content">
                  <h3>{artwork.title}</h3>
                  <p class="artist">{artwork.artist}</p>
                  <p class="price">{artwork.price}</p>
                  
                  <div class="action-buttons">
                    <LikeButton id={artwork.id} />
                    <ShareButton id={artwork.id} title={artwork.title} />
                  </div>
                </div>
              </div>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // ✅ BÚSQUEDA
  document.getElementById('search-input')?.addEventListener('input', (e) => {
    const term = (e.target as HTMLInputElement).value.toLowerCase();
    document.querySelectorAll('.artwork-card').forEach(card => {
      const title = (card as HTMLElement).dataset.title || '';
      const artist = (card as HTMLElement).dataset.artist || '';
      const show = title.includes(term) || artist.includes(term) || term === '';
      (card as HTMLElement).style.display = show ? 'block' : 'none';
    });
  });
</script>

<style>
  .gallery {
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  .gallery-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .gallery-header {
    margin-bottom: var(--spacing-xl);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .gallery-header h1 {
    font-size: 3rem;
    margin: 0;
    font-weight: 700;
  }

  .search-input {
    border: 1px solid var(--border-color);
    padding: var(--spacing-md) var(--spacing-lg);
    font-size: 1rem;
    border-radius: 4px;
    background: transparent;
    color: var(--text);
    min-width: 300px;
    transition: all 0.3s;
  }

  .search-input::placeholder {
    color: var(--text-lighter);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--text);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--spacing-xl);
  }

  .artwork-card {
    border-radius: 8px;
    overflow: hidden;
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
  }

  .artwork-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transform: translateY(-4px);
  }

  .artwork-link {
    display: block;
    text-decoration: none;
  }

  .artwork-image-wrapper {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--bg-light);
  }

  .artwork-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .artwork-card:hover img {
    transform: scale(1.08);
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.85));
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .artwork-card:hover .overlay {
    opacity: 1;
  }

  .overlay-content {
    color: white;
    text-align: center;
    width: 100%;
    padding: var(--spacing-lg);
  }

  .overlay-content h3 {
    font-size: 1.4rem;
    margin-bottom: var(--spacing-sm);
    font-weight: 700;
  }

  .overlay-content .artist {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: var(--spacing-sm);
  }

  .overlay-content .price {
    font-size: 1.3rem;
    font-weight: 700;
    margin: var(--spacing-lg) 0;
    color: #ffd700;
  }

  .action-buttons {
    display: flex;
    gap: var(--spacing-lg);
    justify-content: center;
    align-items: center;
    margin-top: var(--spacing-lg);
  }

  @media (max-width: 968px) {
    .gallery-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .gallery-header h1 {
      font-size: 2.5rem;
    }

    .search-input {
      min-width: 100%;
    }

    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: var(--spacing-lg);
    }

    .overlay-content h3 {
      font-size: 1.1rem;
    }

    .overlay-content .price {
      font-size: 1.1rem;
    }

    .action-buttons {
      gap: var(--spacing-md);
    }
  }

  @media (max-width: 480px) {
    .gallery-header h1 {
      font-size: 1.8rem;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .search-input {
      padding: var(--spacing-sm) var(--spacing-md);
      font-size: 0.9rem;
    }
  }
</style>