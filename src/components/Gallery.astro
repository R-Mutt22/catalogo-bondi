---
import artworksData from '../data/artworks.json';

interface Artwork {
  id: number;
  title: string;
  artist: string;
  category: string;
  price: string;
  imageFile: string;
  thumbFile: string;
  description: string;
  availability: string;
  featured: boolean;
}

const artworks: Artwork[] = artworksData.artworks as Artwork[];
---

<section id="catalogo" class="gallery">
  <div class="gallery-container">
    <div class="gallery-header">
      <h1>Catálogo</h1>
      <input 
        type="text" 
        class="search-input" 
        placeholder="Buscar obra..."
        id="search-input"
      />
    </div>

    <div class="gallery-grid" id="gallery-grid">
      {artworks.map((artwork) => (
        <div 
          class="artwork-card" 
          data-id={artwork.id}
          data-title={artwork.title.toLowerCase()}
          data-artist={artwork.artist.toLowerCase()}
        >
          <a href={`/obra/${artwork.id}`} class="artwork-link">
            <div class="artwork-image-wrapper">
              <img 
                src={`/images/artworks/thumbnails/${artwork.thumbFile}.webp`}
                alt={artwork.title}
                loading="lazy"
              />
              
              <div class="overlay">
                <div class="overlay-content">
                  <h3>{artwork.title}</h3>
                  <p>{artwork.artist}</p>
                  <p class="price">{artwork.price}</p>
                  
                  <div class="action-buttons">
                    <button 
                      class="like-btn" 
                      data-id={artwork.id}
                      onclick="event.preventDefault(); event.stopPropagation(); toggleLike(this);"
                    >
                      🤍
                    </button>
                    
                    <button 
                      class="share-btn"
                      data-title={artwork.title}
                      data-artist={artwork.artist}
                      data-id={artwork.id}
                      onclick="event.preventDefault(); event.stopPropagation(); toggleShare(this);"
                    >
                      📤
                    </button>
                  </div>

                  <div class="share-menu">
                    <a class="share-option whatsapp-share">WhatsApp</a>
                    <a class="share-option facebook-share">Facebook</a>
                    <a class="share-option twitter-share">Twitter</a>
                    <a class="share-option email-share">Email</a>
                  </div>
                </div>
              </div>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // ✅ BÚSQUEDA
  document.getElementById('search-input')?.addEventListener('input', (e) => {
    const term = (e.target as HTMLInputElement).value.toLowerCase();
    document.querySelectorAll('.artwork-card').forEach(card => {
      const title = (card as HTMLElement).dataset.title || '';
      const artist = (card as HTMLElement).dataset.artist || '';
      const show = title.includes(term) || artist.includes(term) || term === '';
      (card as HTMLElement).style.display = show ? 'block' : 'none';
    });
  });

  // ✅ ME GUSTA
  function toggleLike(btn: HTMLElement) {
    (btn as HTMLButtonElement).classList.toggle('liked');
    const id = btn.getAttribute('data-id');
    if (id) {
      const isLiked = (btn as HTMLButtonElement).classList.contains('liked');
      btn.textContent = isLiked ? '❤️' : '🤍';
      if (isLiked) {
        localStorage.setItem(`liked-${id}`, 'true');
        showToast('¡Guardado en favoritos!');
      } else {
        localStorage.removeItem(`liked-${id}`);
      }
    }
  }

  // ✅ COMPARTIR
  function toggleShare(btn: HTMLElement) {
    const menu = btn.closest('.action-buttons')?.querySelector('.share-menu') as HTMLElement;
    if (!menu) return;
    
    menu.classList.toggle('active');
    
    const title = btn.getAttribute('data-title') || 'Obra';
    const artist = btn.getAttribute('data-artist') || '';
    const id = btn.getAttribute('data-id') || '1';
    
    const wa = menu.querySelector('.whatsapp-share') as HTMLAnchorElement;
    const fb = menu.querySelector('.facebook-share') as HTMLAnchorElement;
    const tw = menu.querySelector('.twitter-share') as HTMLAnchorElement;
    const em = menu.querySelector('.email-share') as HTMLAnchorElement;
    
    if (wa) wa.href = `https://wa.me/?text=${encodeURIComponent(`Mira: "${title}" de ${artist}`)}`;
    if (fb) fb.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(window.location.origin + '/obra/' + id)}`;
    if (tw) tw.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(`"${title}" de ${artist}`)}`;
    if (em) em.href = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`Mira esta obra: "${title}" de ${artist}`)}`;
    
    if (wa) wa.target = '_blank';
    if (fb) fb.target = '_blank';
    if (tw) tw.target = '_blank';
  }

  // ✅ CERRAR MENÚ
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('.action-buttons')) {
      document.querySelectorAll('.share-menu.active').forEach(m => {
        (m as HTMLElement).classList.remove('active');
      });
    }
  });

  // ✅ CARGAR LIKES
  document.querySelectorAll('.like-btn').forEach(btn => {
    const id = btn.getAttribute('data-id');
    if (id && localStorage.getItem(`liked-${id}`)) {
      (btn as HTMLButtonElement).classList.add('liked');
      btn.textContent = '❤️';
    }
  });

  // ✅ TOAST
  function showToast(msg: string) {
    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.textContent = msg;
    document.body.appendChild(toast);
    setTimeout(() => toast.classList.add('show'), 10);
    setTimeout(() => {
      toast.classList.remove('show');
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }
</script>

<style>
  .gallery {
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  .gallery-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .gallery-header {
    margin-bottom: var(--spacing-xl);
  }

  .gallery-header h1 {
    font-size: 3rem;
    margin-bottom: var(--spacing-lg);
    font-weight: 700;
  }

  .search-input {
    border: 1px solid var(--border-color);
    padding: var(--spacing-md) var(--spacing-lg);
    font-size: 1rem;
    border-radius: 4px;
    background: transparent;
    color: var(--text);
    min-width: 300px;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--text);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--spacing-xl);
  }

  .artwork-card {
    border-radius: 8px;
    overflow: hidden;
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
  }

  .artwork-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transform: translateY(-4px);
  }

  .artwork-link {
    display: block;
    text-decoration: none;
  }

  .artwork-image-wrapper {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--bg-light);
  }

  .artwork-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .artwork-card:hover img {
    transform: scale(1.08);
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .artwork-card:hover .overlay {
    opacity: 1;
  }

  .overlay-content {
    color: white;
    text-align: center;
    padding: var(--spacing-lg);
  }

  .overlay-content h3 {
    font-size: 1.3rem;
    margin-bottom: var(--spacing-sm);
  }

  .overlay-content p {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .overlay-content .price {
    font-size: 1.2rem;
    font-weight: 600;
    margin: var(--spacing-md) 0;
  }

  .action-buttons {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    position: relative;
  }

  .like-btn,
  .share-btn {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 2px solid white;
    background: rgba(255, 255, 255, 0.2);
    font-size: 1.4rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .like-btn:hover,
  .share-btn:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.1);
  }

  .like-btn.liked {
    background: #ff6b6b;
    border-color: #ff6b6b;
  }

  .share-menu {
    position: absolute;
    bottom: 60px;
    left: 50%;
    transform: translateX(-50%);
    background: white;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    min-width: 160px;
  }

  .share-menu.active {
    opacity: 1;
    pointer-events: all;
  }

  .share-option {
    display: block;
    padding: var(--spacing-md);
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
    border-bottom: 1px solid var(--border-color);
    cursor: pointer;
    transition: background 0.2s;
  }

  .share-option:last-child {
    border-bottom: none;
  }

  .share-option:hover {
    background: var(--bg-light);
  }

  @media (max-width: 768px) {
    .gallery-header h1 {
      font-size: 2rem;
    }

    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--spacing-lg);
    }

    .search-input {
      min-width: 100%;
    }
  }
</style>

<style is:global>
  .toast {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: black;
    color: white;
    padding: 1rem 1.5rem;
    border-radius: 8px;
    z-index: 2000;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .toast.show {
    opacity: 1;
  }
</style>