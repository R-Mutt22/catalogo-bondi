<nav class="nav">
  <div class="nav-container">
    <div class="nav-left">
      <a href="/" class="logo">
        <span class="logo-main">El Bondi</span>
        <span class="logo-sub">Colectivo</span>
      </a>
    </div>
    <ul class="nav-links">
      <li><a href="/">Obras</a></li>
      <li><a href="/historial/">Historial</a></li>
      <li><a href="/contacto/">Contacto</a></li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    border-bottom: 1px solid var(--border-color);
    padding: var(--spacing-lg) var(--spacing-lg);
    position: sticky;
    top: 0;
    background: var(--secondary);
    z-index: 100;
  }

  .nav-container {
    max-width: 1600px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-xl);
  }

  .nav-left {
    display: flex;
    align-items: center;
  }

  .logo {
    display: flex;
    flex-direction: column;
    gap: 0;
    cursor: pointer;
    transition: opacity 0.3s;
  }

  .logo:hover {
    opacity: 0.7;
  }

  .logo-main {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .logo-sub {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--text-light);
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    gap: var(--spacing-xl);
    list-style: none;
    align-items: center;
  }

  .nav-links a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-light);
    transition: color 0.3s;
    position: relative;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  @media (max-width: 968px) {
    .nav {
      padding: var(--spacing-lg) var(--spacing-md);
    }

    .nav-container {
      gap: var(--spacing-lg);
      flex-wrap: wrap;
    }

    .nav-links {
      gap: var(--spacing-lg);
      font-size: 0.85rem;
      width: 100%;
      flex-wrap: wrap;
    }

    .logo-main {
      font-size: 0.9rem;
    }
  }
</style>