---
---

<section id="contacto" class="contact">
  <div class="contact-container">
    <h2>Ponte en <span>Contacto</span></h2>
    <div class="contact-content">
      <div class="contact-info">
        <div class="contact-item">
          <div class="contact-label">📍 Ubicación</div>
          <div class="contact-value">Rosario, Santa Fe, Argentina</div>
        </div>
        <div class="contact-item">
          <div class="contact-label">📧 Email</div>
          <div class="contact-value">info@elbondicolectivo.com</div>
        </div>
        <div class="contact-item">
          <div class="contact-label">📱 WhatsApp</div>
          <div class="contact-value">+54 341 123 4567</div>
        </div>
        <div class="contact-item">
          <div class="contact-label">🔗 Redes Sociales</div>
          <div class="contact-value">
            @elbondicolectivo en Instagram<br />
            @elbondicolectivo en Facebook<br />
            @elbondicolectivo en Twitter
          </div>
        </div>
        <div class="contact-item">
          <div class="contact-label">🕐 Horarios de Atención</div>
          <div class="contact-value">
            Lunes a Viernes: 10:00 - 18:00<br />
            Sábados: 12:00 - 17:00<br />
            Domingos: Cerrado
          </div>
        </div>
      </div>
      <form class="contact-form" id="contact-form">
        <div class="form-group">
          <label class="form-label">Nombre</label>
          <input type="text" class="form-input" required />
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" class="form-input" required />
        </div>
        <div class="form-group">
          <label class="form-label">Asunto</label>
          <input type="text" class="form-input" required />
        </div>
        <div class="form-group">
          <label class="form-label">Mensaje</label>
          <textarea class="form-textarea" required></textarea>
        </div>
        <button type="submit" class="submit-btn">Enviar Mensaje</button>
      </form>
    </div>
  </div>
</section>

<script>
  // ✅ CORRECCIÓN: Casteamos el form correctamente
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    form.addEventListener('submit', (e: Event) => {
      e.preventDefault();
      
      // ✅ Mostramos el toast
      const toast = document.createElement('div');
      toast.className = 'toast';
      toast.textContent = '¡Mensaje enviado! Nos pondremos en contacto pronto.';
      document.body.appendChild(toast);
      
      // ✅ Limpiar el formulario
      const inputs = form.querySelectorAll('input, textarea');
      inputs.forEach((input) => {
        if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) {
          input.value = '';
        }
      });
      
      // Remover toast después de 3 segundos
      setTimeout(() => toast.remove(), 3000);
    });
  }
</script>

<style>
  .contact {
    padding: var(--spacing-xl) var(--spacing-lg);
    border-bottom: 1px solid var(--border-color);
  }

  .contact-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .contact-container h2 {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-xl);
  }

  .contact-container h2 span {
    color: var(--accent);
  }

  .contact-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    margin-top: var(--spacing-xl);
  }

  .contact-info {
    background: var(--bg-light);
    padding: var(--spacing-lg);
    border-radius: 8px;
  }

  .contact-item {
    margin-bottom: var(--spacing-lg);
  }

  .contact-label {
    font-weight: 700;
    color: var(--primary);
    margin-bottom: var(--spacing-xs);
    font-size: 0.9rem;
  }

  .contact-value {
    color: var(--text-secondary);
    font-size: 0.95rem;
    word-break: break-word;
  }

  .contact-form {
    background: white;
    padding: var(--spacing-lg);
    border-radius: 8px;
    box-shadow: var(--shadow-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .form-label {
    display: block;
    margin-bottom: var(--spacing-xs);
    font-weight: 600;
    color: var(--primary);
    font-size: 0.9rem;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: var(--spacing-md);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color 0.3s;
    background: transparent;
    color: var(--text-primary);
  }

  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.05);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .submit-btn {
    background: var(--primary);
    color: white;
    padding: var(--spacing-md);
    border: none;
    border-radius: 4px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 1rem;
    letter-spacing: 0.5px;
    margin-top: var(--spacing-md);
  }

  .submit-btn:hover {
    opacity: 0.8;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .contact {
      padding: var(--spacing-lg) var(--spacing-md);
    }

    .contact-container h2 {
      font-size: 1.8rem;
    }

    .contact-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
  }
</style>

<style is:global>
  .toast {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: var(--primary);
    color: white;
    padding: 1rem 1.5rem;
    border-radius: 4px;
    box-shadow: var(--shadow-medium);
    z-index: 2000;
    animation: slideIn 0.3s ease;
  }

  @keyframes slideIn {
    from {
      transform: translateX(400px);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }
</style>