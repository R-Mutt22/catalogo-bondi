---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

// LEER PARÁMETRO DE LA URL CORRECTAMENTE
const url = new URL(Astro.request.url);
const obraParam = url.searchParams.get('obra') || '';
---

<Layout title="Contacto - El Bondi Colectivo">
  <Navigation />
  
  <section id="contacto" class="contact-section">
    <div class="container">
      <h1>Contacto</h1>
      <p class="subtitle">¿Preguntas? Nos gustaría saber de vos</p>

      <div class="contact-content">
        <!-- INFORMACIÓN LADO IZQUIERDO -->
        <div class="contact-info">
          <h3>Información</h3>
          <div class="info-item">
            <label>Ubicación</label>
            <p>Argentina</p>
          </div>
          <div class="info-item">
            <label>Email</label>
            <p><a href="mailto:elbondicolectivo@gmail.com">elbondicolectivo@gmail.com</a></p>
          </div>
          <div class="info-item">
            <label>WhatsApp</label>
            <p><a href="https://wa.me/543816325567" target="_blank">+54 381 123 4567</a></p>
          </div>
          <div class="info-item">
            <label>Horarios</label>
            <p>Lunes a Viernes: 10:00 - 18:00<br>Sábados: 12:00 - 16:00</p>
          </div>
        </div>

        <!-- FORMULARIO LADO DERECHO -->
        <form 
          class="contact-form"
          action="https://formspree.io/f/mojrgnpa"
          method="POST"
        >
          <div class="form-group">
            <label for="name">Nombre *</label>
            <input 
              type="text" 
              id="name"
              name="name"
              placeholder="Tu nombre" 
              required 
            />
          </div>

          <div class="form-group">
            <label for="email">Email *</label>
            <input 
              type="email" 
              id="email"
              name="email"
              placeholder="tu@email.com" 
              required 
            />
          </div>

          <div class="form-group">
            <label for="phone">Teléfono</label>
            <input 
              type="tel" 
              id="phone"
              name="phone"
              placeholder="+54 9 11 2345-6789"
            />
          </div>

          <div class="form-group">
            <label for="artwork">¿Obra de interés?</label>
            <input 
              type="text" 
              id="artwork"
              name="artwork"
              value={obraParam}
              placeholder="Ej: Dinofa"
            />
          </div>

          <div class="form-group">
            <label for="message">Mensaje *</label>
            <textarea 
              id="message" 
              name="message"
              placeholder="Cuéntanos qué te interesa..."
              rows="5"
              required
            ></textarea>
          </div>

          <button type="submit" class="submit-btn">Enviar mensaje</button>
          <p class="form-note">* Campos obligatorios</p>
        </form>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .contact-section {
    padding: var(--spacing-xl) var(--spacing-lg);
    min-height: 70vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  h1 {
    font-size: 3rem;
    margin-bottom: var(--spacing-md);
    font-weight: 700;
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-bottom: var(--spacing-xl);
  }

  .contact-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    margin-top: var(--spacing-xl);
  }

  /* INFORMACIÓN IZQUIERDA */
  .contact-info {
    background: var(--bg-light);
    padding: var(--spacing-lg);
    border-radius: 4px;
  }

  .contact-info h3 {
    font-size: 1.1rem;
    margin-bottom: var(--spacing-lg);
    font-weight: 600;
  }

  .info-item {
    margin-bottom: var(--spacing-lg);
  }

  .info-item label {
    display: block;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-light);
    margin-bottom: var(--spacing-xs);
    font-weight: 600;
  }

  .info-item p {
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.5;
  }

  .info-item a {
    color: var(--text);
    text-decoration: none;
    transition: opacity 0.3s;
    border-bottom: 1px solid var(--border-color);
  }

  .info-item a:hover {
    opacity: 0.7;
  }

  /* FORMULARIO DERECHA */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-group label {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
    color: var(--text);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: var(--spacing-md);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    font-size: 0.95rem;
    font-family: inherit;
    background: transparent;
    color: var(--text);
    transition: all 0.3s;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--text-lighter);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--text);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .submit-btn {
    padding: var(--spacing-md) var(--spacing-lg);
    background: black;
    color: white;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s;
    margin-top: var(--spacing-sm);
  }

  .submit-btn:hover {
    background: var(--text);
    transform: translateY(-2px);
  }

  .submit-btn:active {
    transform: translateY(0);
  }

  .form-note {
    font-size: 0.85rem;
    color: var(--text-lighter);
    margin-top: var(--spacing-sm);
  }

  /* RESPONSIVE */
  @media (max-width: 968px) {
    .contact-section {
      padding: var(--spacing-lg) var(--spacing-md);
    }

    h1 {
      font-size: 2.5rem;
    }

    .contact-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    .form-group label {
      font-size: 0.9rem;
    }

    .form-group input,
    .form-group textarea {
      padding: var(--spacing-sm) var(--spacing-md);
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .contact-section {
      padding: var(--spacing-lg) var(--spacing-sm);
    }

    h1 {
      font-size: 1.8rem;
    }

    .subtitle {
      font-size: 1rem;
    }

    .contact-info {
      padding: var(--spacing-md);
    }

    .submit-btn {
      padding: var(--spacing-md);
    }
  }
</style>