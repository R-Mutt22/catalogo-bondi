---
interface Props {
  id: number;
  title: string;
}

const { id, title } = Astro.props;
const shareUrl = `${Astro.url.origin}/obra/${id}`;
---

<div class="share-button-wrapper" data-id={id}>
  <button class="share-btn" data-id={id} aria-label="Compartir">
    <span class="share-icon">↗</span>
  </button>
  
  <div class="share-menu" data-id={id}>
    <a href={`https://wa.me/?text=${encodeURIComponent(`Mira esta obra: "${title}" - ${shareUrl}`)}`}
       target="_blank"
       class="share-option whatsapp"
       aria-label="Compartir en WhatsApp">
      WhatsApp
    </a>
    
    <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}
       target="_blank"
       class="share-option facebook"
       aria-label="Compartir en Facebook">
      Facebook
    </a>
    
    <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`"${title}"`)}&url=${encodeURIComponent(shareUrl)}`}
       target="_blank"
       class="share-option twitter"
       aria-label="Compartir en Twitter">
      Twitter
    </a>
    
    <a href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`Te comparto esta obra: "${title}" - ${shareUrl}`)}`}
       class="share-option email"
       aria-label="Compartir por Email">
      Email
    </a>
  </div>
</div>

<script>
  function initShareButton() {
    const buttons = document.querySelectorAll('.share-btn');
    
    buttons.forEach(btn => {
      const id = btn.getAttribute('data-id');
      if (!id) return;
      
      const menu = document.querySelector(`.share-menu[data-id="${id}"]`);
      if (!menu) return;
      
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        // Cerrar otros menús
        document.querySelectorAll('.share-menu.active').forEach(m => {
          if (m !== menu) {
            m.classList.remove('active');
          }
        });
        
        menu.classList.toggle('active');
      });
    });
    
    // Cerrar menú al hacer click afuera
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.share-button-wrapper')) {
        document.querySelectorAll('.share-menu.active').forEach(m => {
          m.classList.remove('active');
        });
      }
    });
  }
  
  // Inicializar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShareButton);
  } else {
    initShareButton();
  }
</script>

<style>
  .share-button-wrapper {
    position: relative;
  }

  .share-btn {
    width: 50px;
    height: 50px;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .share-btn:hover {
    border-color: white;
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }

  .share-icon {
    font-size: 1.3rem;
    color: white;
  }

  .share-menu {
    position: absolute;
    bottom: 65px;
    right: 0;
    background: white;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    min-width: 160px;
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease;
    transform: translateY(10px);
    z-index: 100;
  }

  .share-menu.active {
    opacity: 1;
    pointer-events: all;
    transform: translateY(0);
  }

  .share-option {
    display: block;
    padding: 1rem;
    color: #333;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    border-bottom: 1px solid #eee;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .share-option:last-child {
    border-bottom: none;
  }

  .share-option:hover {
    background: #f5f5f5;
    padding-left: 1.2rem;
  }

  .share-option.whatsapp:hover {
    background: #e8f5e9;
    color: #25d366;
  }

  .share-option.facebook:hover {
    background: #e7f3ff;
    color: #1877f2;
  }

  .share-option.twitter:hover {
    background: #e1f5fe;
    color: #1da1f2;
  }

  .share-option.email:hover {
    background: #fff3e0;
    color: #ff9800;
  }

  @media (max-width: 768px) {
    .share-btn {
      width: 45px;
      height: 45px;
    }

    .share-icon {
      font-size: 1.1rem;
    }

    .share-menu {
      right: auto;
      left: 50%;
      transform: translateX(-50%) translateY(10px);
    }

    .share-menu.active {
      transform: translateX(-50%) translateY(0);
    }
  }
</style>