---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import artworksData from '../../data/artworks.json';

interface Artwork {
  id: number;
  title: string;
  artist: string;
  category: string;
  price: string;
  imageFile: string;
  longDescription: string;
  dimensions: string;
  year: number;
  medium: string;
  availability: string;
  tags: string[];
}

export async function getStaticPaths() {
  return artworksData.artworks.map((artwork: Artwork) => ({
    params: { id: String(artwork.id) },
    props: { artwork },
  }));
}

const { artwork } = Astro.props as { artwork: Artwork };
const allArtworks = artworksData.artworks;
const currentIndex = allArtworks.findIndex((a: Artwork) => a.id === artwork.id);
const nextArtwork = allArtworks[(currentIndex + 1) % allArtworks.length];
const prevArtwork = allArtworks[(currentIndex - 1 + allArtworks.length) % allArtworks.length];

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/artworks/*.jpg',
  { eager: true }
);

const getImage = (filename: string) => {
  const path = `/src/assets/images/artworks/${filename}.jpg`;
  return imageModules[path]?.default?.src || null;
};
---

<Layout title={artwork.title}>
  <Navigation />
  
  <section class="work-detail">
    <div class="work-container">
      <a href="/" class="back-link">← Volver al catálogo</a>

      <div class="work-header">
        <h1>{artwork.title}</h1>
        <p class="artist">{artwork.artist}</p>
      </div>

      <div class="work-content">
        <div class="work-image">
          <img src={getImage(artwork.imageFile)} alt={artwork.title} />
        </div>

        <div class="work-sidebar">
          <div class="work-meta">
            <div class="meta-item">
              <span class="label">Categoría</span>
              <span class="value">{artwork.category}</span>
            </div>
            <div class="meta-item">
              <span class="label">Año</span>
              <span class="value">{artwork.year}</span>
            </div>
            <div class="meta-item">
              <span class="label">Dimensiones</span>
              <span class="value">{artwork.dimensions}</span>
            </div>
            <div class="meta-item">
              <span class="label">Técnica</span>
              <span class="value">{artwork.medium}</span>
            </div>
            <div class="meta-item">
              <span class="label">Estado</span>
              <span class="value">{artwork.availability}</span>
            </div>
          </div>

          <div class="price-section">
            <p class="price">{artwork.price}</p>
            <button class="contact-btn" onclick="window.location.href='/#contacto'">
              Contactar
            </button>
          </div>

          <div class="tags">
            {artwork.tags.map((tag: string) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>

          <div class="share-buttons">
            <button onclick="shareWhatsApp()">WhatsApp</button>
            <button onclick="shareTwitter()">Twitter</button>
            <button onclick="shareFacebook()">Facebook</button>
            <button onclick="shareEmail()">Email</button>
          </div>
        </div>
      </div>

      <div class="description-section">
        <h2>Sobre la obra</h2>
        <p>{artwork.longDescription}</p>
      </div>

      <!-- NAVEGACIÓN -->
      <div class="navigation-section">
        <a href={`/obra/${prevArtwork.id}`} class="nav-card">
          <span>← Anterior</span>
          <h4>{prevArtwork.title}</h4>
          <p>{prevArtwork.artist}</p>
        </a>
        <a href={`/obra/${nextArtwork.id}`} class="nav-card next">
          <span>Siguiente →</span>
          <h4>{nextArtwork.title}</h4>
          <p>{nextArtwork.artist}</p>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script define:vars={{ title: artwork.title, artist: artwork.artist }}>
  function shareWhatsApp() {
    const text = `Mira esta obra: "${title}" de ${artist}`;
    window.open(`https://wa.me/?text=${encodeURIComponent(text)}`);
  }
  
  function shareTwitter() {
    const text = `"${title}" de ${artist} - El Bondi Colectivo`;
    window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}`);
  }
  
  function shareFacebook() {
    window.open('https://www.facebook.com/sharer/sharer.php?u=' + window.location.href);
  }
  
  function shareEmail() {
    window.location.href = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(window.location.href)}`;
  }
</script>

<style>
  .work-detail {
    padding: var(--spacing-xl) var(--spacing-lg);
    min-height: 100vh;
  }

  .work-container {
    max-width: 1600px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--text-light);
    text-decoration: none;
    margin-bottom: var(--spacing-lg);
    transition: color 0.3s;
  }

  .back-link:hover {
    color: var(--text);
  }

  .work-header {
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
    border-bottom: 1px solid var(--border-color);
  }

  .work-header h1 {
    margin-bottom: var(--spacing-md);
  }

  .work-header .artist {
    font-size: 1.1rem;
    color: var(--text-light);
  }

  .work-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-xl);
  }

  .work-image {
    position: relative;
    aspect-ratio: 3/4;
    background: var(--bg-light);
    border-radius: 4px;
    overflow: hidden;
  }

  .work-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .work-meta {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    padding: var(--spacing-lg);
    background: var(--bg-light);
    border-radius: 4px;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-light);
    font-weight: 600;
  }

  .value {
    font-size: 0.95rem;
    color: var(--text);
    font-weight: 500;
  }

  .price-section {
    border-top: 1px solid var(--border-color);
    padding-top: var(--spacing-lg);
  }

  .price {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: var(--spacing-md);
  }

  .contact-btn {
    width: 100%;
    padding: var(--spacing-md);
    background: var(--text);
    color: white;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
  }

  .contact-btn:hover {
    opacity: 0.8;
  }

  .tags {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--border-color);
  }

  .tag {
    font-size: 0.75rem;
    color: var(--text-light);
    background: white;
    padding: var(--spacing-xs) var(--spacing-sm);
    border: 1px solid var(--border-color);
    border-radius: 4px;
  }

  .share-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--border-color);
  }

  .share-buttons button {
    padding: var(--spacing-sm);
    border: 1px solid var(--border-color);
    background: transparent;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
  }

  .share-buttons button:hover {
    background: var(--bg-light);
    border-color: var(--text);
  }

  .description-section {
    margin-bottom: var(--spacing-xl);
    padding: var(--spacing-lg);
    background: var(--bg-light);
    border-radius: 4px;
  }

  .description-section h2 {
    font-size: 1.3rem;
    margin-bottom: var(--spacing-md);
  }

  .description-section p {
    color: var(--text-light);
    line-height: 1.8;
  }

  .navigation-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin-top: var(--spacing-xl);
  }

  .nav-card {
    padding: var(--spacing-lg);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s;
  }

  .nav-card:hover {
    border-color: var(--text);
    background: var(--bg-light);
  }

  .nav-card span {
    font-size: 0.85rem;
    color: var(--text-light);
    display: block;
    margin-bottom: var(--spacing-md);
  }

  .nav-card h4 {
    font-size: 1rem;
    margin-bottom: var(--spacing-xs);
  }

  .nav-card p {
    font-size: 0.85rem;
    color: var(--text-light);
  }

  @media (max-width: 968px) {
    .work-detail {
      padding: var(--spacing-lg) var(--spacing-md);
    }

    .work-header h1 {
      font-size: 2rem;
    }

    .work-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    .work-image {
      aspect-ratio: auto;
      min-height: 400px;
    }

    .navigation-section {
      grid-template-columns: 1fr;
    }

    .share-buttons {
      grid-template-columns: 1fr;
    }
  }
</style>