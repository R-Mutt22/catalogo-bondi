---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import artworksData from '../../data/artworks.json';

interface Artwork {
  id: number;
  title: string;
  artist: string;
  category: string;
  price: string;
  imageFile: string;
  thumbFile: string;
  description: string;
  longDescription: string;
  dimensions: string;
  year: number;
  medium: string;
  availability: string;
  featured: boolean;
}

// ✅ MOVER getStaticPaths AQUÍ Y DEFINIR artworks DENTRO
export function getStaticPaths() {
  const artworks: Artwork[] = (artworksData as any).artworks as Artwork[];
  return artworks.map(artwork => ({
    params: { id: artwork.id.toString() },
    props: { artwork }
  }));
}

interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
---

<Layout title={artwork.title}>
  <Navigation />
  
  <div class="obra-container">
    <a href="/" class="back-link">← Volver al catálogo</a>
    
    <div class="obra-content">
      <!-- IMAGEN PRINCIPAL -->
      <div class="imagen-principal">
        <img 
          src={`/images/artworks/${artwork.imageFile}.webp`}
          alt={artwork.title}
          class="main-image"
        />
      </div>

      <!-- INFORMACIÓN -->
      <div class="obra-info">
        <h1>{artwork.title}</h1>
        <p class="artist">{artwork.artist}</p>

        <div class="details">
          <div class="detail-item">
            <span class="label">Categoría</span>
            <span class="value">{artwork.category}</span>
          </div>
          <div class="detail-item">
            <span class="label">Año</span>
            <span class="value">{artwork.year}</span>
          </div>
          <div class="detail-item">
            <span class="label">Dimensiones</span>
            <span class="value">{artwork.dimensions}</span>
          </div>
          <div class="detail-item">
            <span class="label">Técnica</span>
            <span class="value">{artwork.medium}</span>
          </div>
          <div class="detail-item">
            <span class="label">Estado</span>
            <span class="value">{artwork.availability}</span>
          </div>
        </div>

        <p class="description">{artwork.longDescription}</p>

        <div class="precio-seccion">
          <p class="precio">{artwork.price}</p>
          <a href={`/contacto/?obra=${artwork.title}`} class="contactar-btn">
            Contactar
          </a>
        </div>

        <!-- COMPARTIR -->
        <div class="share-section">
          <p>Compartir:</p>
          <div class="share-buttons">
            <a 
              class="share-link" 
              href={`https://wa.me/?text=${encodeURIComponent(`Mira: "${artwork.title}" de ${artwork.artist}`)}`}
              target="_blank"
            >
              WhatsApp
            </a>
            <a 
              class="share-link"
              href="https://www.facebook.com"
              target="_blank"
            >
              Facebook
            </a>
            <a 
              class="share-link"
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`"${artwork.title}" de ${artwork.artist}`)}`}
              target="_blank"
            >
              Twitter
            </a>
            <a 
              class="share-link"
              href={`mailto:?subject=${encodeURIComponent(artwork.title)}`}
            >
              Email
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .obra-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--spacing-xl);
    color: var(--text-light);
    text-decoration: none;
    transition: color 0.3s;
  }

  .back-link:hover {
    color: var(--text);
  }

  .obra-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
  }

  .imagen-principal {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    background: var(--bg-light);
  }

  .main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .obra-info h1 {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-sm);
    font-weight: 700;
  }

  .artist {
    font-size: 1.2rem;
    color: var(--text-light);
    margin-bottom: var(--spacing-lg);
  }

  .details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin: var(--spacing-xl) 0;
    padding: var(--spacing-lg) 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .detail-item {
    display: flex;
    flex-direction: column;
  }

  .label {
    font-size: 0.85rem;
    text-transform: uppercase;
    color: var(--text-lighter);
    margin-bottom: var(--spacing-xs);
    letter-spacing: 0.05em;
  }

  .value {
    font-size: 1rem;
    color: var(--text);
  }

  .description {
    margin: var(--spacing-lg) 0;
    line-height: 1.6;
    color: var(--text-light);
  }

  .precio-seccion {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    margin: var(--spacing-xl) 0;
  }

  .precio {
    font-size: 2rem;
    font-weight: 700;
  }

  .contactar-btn {
    background: black;
    color: white;
    padding: var(--spacing-md) var(--spacing-lg);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.3s;
    display: inline-block;         /* ← AGREGADO */
    text-decoration: none;        /* ← AGREGADO */
    text-align: center;           /* ← AGREGADO */
  }

  .contactar-btn:hover {
    background: var(--text);
  }

  .share-section {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--border-color);
  }

  .share-section p {
    margin-bottom: var(--spacing-md);
  }

  .share-buttons {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .share-link {
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    text-decoration: none;
    color: var(--text);
    transition: all 0.3s;
  }

  .share-link:hover {
    background: var(--bg-light);
  }

  @media (max-width: 968px) {
    .obra-content {
      grid-template-columns: 1fr;
    }

    .obra-info h1 {
      font-size: 2rem;
    }

    .details {
      grid-template-columns: 1fr;
    }
  }
</style>