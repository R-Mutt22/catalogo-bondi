---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const history = [
  {
    year: 2026,
    title: "Laboratorio de Emboscadas",
    description: "Desarrollo de un programa de formación y clínica de obra, transfiriendo las metodologías de 'guerrilla artística' y soberanía técnica a nuevas generaciones de artistas del NOA."
  },
  {
    year: 2025,
    title: "ZARZA: Alto guiso votivo",
    description: "Exhibición en el Centro Cultural Alberto Rougés. Instalación de sitio específico que replica la 'llama eterna' de la Casa de Gobierno de Tucumán, activada mediante un sistema de biogás alimentado por desechos orgánicos."
  },
  {
    year: 2024,
    title: "Soberanía Energética y Biocombustibles",
    description: "Inicio de una línea de investigación sobre energías renovables aplicadas al arte. El colectivo explora la producción de biogás como desechos orgánicos, buscando autonomía y cuestionando los sistemas de consumo."
  },
  {
    year: 2023,
    title: "Monumentos que crecen hacia adentro",
    description: "Cierre del Programa de Artistas de la Universidad Torcuato Di Tella con la presentación de 'De la Venus Roja' en Buenos Aires."
  },
  {
    year: 2022,
    title: "Primer Premio Nacional MUNT",
    description: "Obtención del 1er Premio en el XVI Salón Nacional de Arte Contemporáneo con la instalación 'Teatro de Saturno indoor'. Participación en el 110° Salón Nacional de Artes Visuales."
  },
  {
    year: 2021,
    title: "BIENALSUR",
    description: "Exhibición de 'Eterno Retorno del Nuevo Mundo', una propuesta que tensiona la arqueología y el arte contemporáneo en diálogo con el contexto regional."
  },
  {
    year: 2020,
    title: "Resiliencia y Registro",
    description: "Fase de documentación y replanteo de prácticas artísticas en espacios confinados, profundizando en el archivo como obra de arte."
  },
  {
    year: 2019,
    title: "Bienal de Arte Joven",
    description: "Presentación de 'C-14' en el Centro Cultural Recoleta, una instalación-acción sobre la producción cerámica ancestral y la identidad del Noroeste Argentino."
  },
  {
    year: 2018,
    title: "Proyecciones Federales",
    description: "Circulación de obras en salones regionales y nacionales, consolidando el discurso crítico sobre los métodos de exhibición estática."
  },
  {
    year: 2017,
    title: "Acciones de Sitio Específico",
    description: "Desarrollo de intervenciones urbanas que buscan forzar al espectador a activar sus sentidos ante el entorno cotidiano."
  },
  {
    year: 2016,
    title: "Maduración Grupal",
    description: "Participación en clínicas de análisis de obra y residencias, fortaleciendo el concepto de la 'canción sobre el cantante' en la producción colectiva."
  },
  {
    year: 2015,
    title: "Mercadicto y Espacios Alternativos",
    description: "Consolidación de proyectos de autogestión y ferias de arte independiente, rompiendo con los circuitos institucionales tradicionales."
  },
  {
    year: 2014,
    title: "Guerrilla Artística: Falcon y Tanque",
    description: "Intervenciones de alto impacto social en la Vigilia por el Día de la Memoria, profundizando en el arte como herramienta de tensión política."
  },
  {
    year: 2013,
    title: "Stanpunkslebre: El Hito Fundante",
    description: "Primera muestra oficial en el Tucumán Hostel. Con la creación del tanque de cartón, se establece la metodología de 'sin autoría': el colectivo prima sobre el individuo, hackeando la escena local."
  },
  {
    year: 2012,
    title: "Primeras Emboscadas",
    description: "Inician las prácticas de campo y la inclusión de recursos que permiten una mirada crítica al entorno urbano de San Miguel de Tucumán."
  },
  {
    year: 2011,
    title: "Fundación en Tucumán",
    description: "Nace El Bondi Colectivo bajo la premisa de que el arte es una forma de emboscada, enfocándose en la 'canción' y no en el 'cantante'."
  }
];
---

<Layout title="Historial - El Bondi Colectivo">
  <Navigation />
  
  <section class="history-section">
    <div class="container">
      <h1>Historial</h1>
      <p class="subtitle">Nuestros hitos y trayectoria</p>
      
      <div class="timeline">
        {history.map((item, index) => (
          <div class="timeline-item" style={`--index: ${index}`}>
            <div class="timeline-year">{item.year}</div>
            <div class="timeline-content">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .history-section {
    padding: var(--spacing-xl) var(--spacing-lg);
    min-height: 60vh;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
  }

  h1 {
    margin-bottom: var(--spacing-md);
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-bottom: var(--spacing-xl);
  }

  .timeline {
    position: relative;
    padding: var(--spacing-xl) 0;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 100%;
    background: var(--border-color);
  }

  .timeline-item {
    margin-bottom: var(--spacing-xl);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    align-items: center;
    position: relative;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 12px;
    background: var(--text);
    border-radius: 50%;
    border: 3px solid white;
    z-index: 10;
    top: 0;
  }

  .timeline-item:nth-child(odd) .timeline-year {
    text-align: right;
    padding-right: var(--spacing-lg);
    border-right: 2px solid var(--text);
  }

  .timeline-item:nth-child(even) .timeline-year {
    text-align: left;
    padding-left: var(--spacing-lg);
    border-left: 2px solid var(--text);
  }

  .timeline-year {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text);
  }

  .timeline-content {
    padding: var(--spacing-lg);
    background: var(--bg-light);
    border-radius: 4px;
  }

  .timeline-content h3 {
    font-size: 1.1rem;
    margin-bottom: var(--spacing-sm);
  }

  .timeline-content p {
    color: var(--text-light);
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .history-section {
      padding: var(--spacing-lg) var(--spacing-md);
    }

    h1 {
      font-size: 2rem;
    }

    .timeline::before {
      left: 0;
    }

    .timeline-item {
      grid-template-columns: 100px 1fr;
      gap: var(--spacing-md);
    }

    .timeline-item::before {
      left: 0;
    }

    .timeline-item:nth-child(odd) .timeline-year,
    .timeline-item:nth-child(even) .timeline-year {
      text-align: left;
      padding-left: var(--spacing-md);
      padding-right: 0;
      border: none;
      border-left: 2px solid var(--text);
    }

    .timeline-content {
      grid-column: 2;
    }
  }
</style>