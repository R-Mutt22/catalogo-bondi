---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contacto - El Bondi Colectivo">
  <Navigation />
  
  <section id="contacto" class="contact-section">
    <div class="container">
      <h1>Contacto</h1>
      <p class="subtitle">¿Preguntas? Nos gustaría saber de ti</p>

      <div class="contact-content">
        <div class="contact-info">
          <h3>Información</h3>
          <div class="info-item">
            <label>Ubicación</label>
            <p>Rosario, Santa Fe, Argentina</p>
          </div>
          <div class="info-item">
            <label>Email</label>
            <p><a href="mailto:info@elbondicolectivo.com">info@elbondicolectivo.com</a></p>
          </div>
          <div class="info-item">
            <label>WhatsApp</label>
            <p><a href="https://wa.me/543411234567" target="_blank">+54 341 123 4567</a></p>
          </div>
          <div class="info-item">
            <label>Horarios</label>
            <p>Lunes a Viernes: 10:00 - 18:00<br>Sábados: 12:00 - 17:00</p>
          </div>
        </div>

        <form class="contact-form" id="contact-form">
          <div class="form-group">
            <input type="text" placeholder="Nombre" required />
          </div>
          <div class="form-group">
            <input type="email" placeholder="Email" required />
          </div>
          <div class="form-group">
            <input type="text" placeholder="Asunto" required />
          </div>
          <div class="form-group">
            <textarea placeholder="Mensaje" rows="5" required></textarea>
          </div>
          <button type="submit" class="submit-btn">Enviar</button>
        </form>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  // ✅ CORRECCIÓN: Castear correctamente el formulario
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  
  if (form) {
    form.addEventListener('submit', (e: Event) => {
      e.preventDefault();
      
      // Mostrar toast
      const toast = document.createElement('div');
      toast.style.cssText = `
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: #000;
        color: white;
        padding: 1rem 1.5rem;
        border-radius: 4px;
        font-size: 0.9rem;
        z-index: 2000;
        animation: slideIn 0.3s ease;
      `;
      toast.textContent = '¡Mensaje enviado! Nos pondremos en contacto pronto.';
      document.body.appendChild(toast);
      
      // ✅ Limpiar el formulario - Sin usar .reset()
      const inputs = form.querySelectorAll('input, textarea');
      inputs.forEach((input) => {
        if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) {
          input.value = '';
        }
      });
      
      setTimeout(() => toast.remove(), 3000);
    });
  }
</script>

<style>
  .contact-section {
    padding: var(--spacing-xl) var(--spacing-lg);
    min-height: 70vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  h1 {
    margin-bottom: var(--spacing-md);
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-bottom: var(--spacing-xl);
  }

  .contact-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    margin-top: var(--spacing-xl);
  }

  .contact-info {
    background: var(--bg-light);
    padding: var(--spacing-lg);
    border-radius: 4px;
  }

  .contact-info h3 {
    font-size: 1.1rem;
    margin-bottom: var(--spacing-lg);
  }

  .info-item {
    margin-bottom: var(--spacing-lg);
  }

  .info-item label {
    display: block;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-light);
    margin-bottom: var(--spacing-xs);
    font-weight: 600;
  }

  .info-item p {
    font-size: 0.95rem;
    color: var(--text);
  }

  .info-item a {
    color: var(--text);
    text-decoration: none;
    transition: opacity 0.3s;
  }

  .info-item a:hover {
    opacity: 0.7;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: var(--spacing-md);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    font-size: 0.95rem;
    background: transparent;
    color: var(--text);
    transition: border-color 0.3s;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--text-lighter);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--text);
  }

  .submit-btn {
    padding: var(--spacing-md);
    background: var(--text);
    color: white;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    margin-top: var(--spacing-md);
  }

  .submit-btn:hover {
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .contact-section {
      padding: var(--spacing-lg) var(--spacing-md);
    }

    h1 {
      font-size: 2rem;
    }

    .contact-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
  }
</style>