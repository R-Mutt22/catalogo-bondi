---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const releases = [
  {
    id: 1,
    title: "Confluencias Urbanas - Exposición Individual",
    artist: "Martín González",
    date: "2024-01-15",
    description: "Primera exposición individual de Martín González",
    image: "01-confluencias-urbanas",
    type: "Exposición"
  },
  {
    id: 2,
    title: "Esculturas de Laura Fernández",
    artist: "Laura Fernández",
    date: "2023-12-01",
    description: "Nuevo ciclo de esculturas en bronce",
    image: "03-equilibrio-suspendido",
    type: "Colección"
  },
  {
    id: 3,
    title: "Fotografías Documentales",
    artist: "Carlos Ruiz",
    date: "2023-11-20",
    description: "Serie fotográfica sobre la vida cotidiana",
    image: "05-instantes-cotidianos",
    type: "Fotografía"
  },
  {
    id: 4,
    title: "Realidades Digitales",
    artist: "Ana Morales",
    date: "2023-10-10",
    description: "Nuevas experiencias en realidad aumentada",
    image: "07-realidad-aumentada",
    type: "Digital"
  }
];
---

<Layout title="Releases - El Bondi Colectivo">
  <Navigation />
  
  <section class="releases-section">
    <div class="container">
      <h1>Releases</h1>
      <p class="subtitle">Últimas novedades y exposiciones</p>
      
      <div class="releases-grid">
        {releases.map((release) => (
          <div class="release-card">
            <div class="release-image">
              <img src={`/images/artworks/${release.image}.jpg`} alt={release.title} />
              <span class="badge">{release.type}</span>
            </div>
            <div class="release-info">
              <p class="date">{new Date(release.date).toLocaleDateString('es-AR')}</p>
              <h3>{release.title}</h3>
              <p class="artist">{release.artist}</p>
              <p class="description">{release.description}</p>
              <a href="#" class="read-more">Leer más →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .releases-section {
    padding: var(--spacing-xl) var(--spacing-lg);
    min-height: 60vh;
  }

  .container {
    max-width: 1600px;
    margin: 0 auto;
  }

  h1 {
    margin-bottom: var(--spacing-md);
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-bottom: var(--spacing-xl);
  }

  .releases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--spacing-lg);
  }

  .release-card {
    background: white;
    border-radius: 4px;
    overflow: hidden;
    transition: all 0.3s;
    cursor: pointer;
  }

  .release-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .release-image {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--bg-light);
  }

  .release-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .release-card:hover .release-image img {
    transform: scale(1.05);
  }

  .badge {
    position: absolute;
    top: var(--spacing-md);
    right: var(--spacing-md);
    background: rgba(0, 0, 0, 0.7);
    color: white;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: 4px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .release-info {
    padding: var(--spacing-lg);
  }

  .date {
    font-size: 0.8rem;
    color: var(--text-lighter);
    margin-bottom: var(--spacing-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .release-info h3 {
    font-size: 1.1rem;
    margin-bottom: var(--spacing-sm);
  }

  .artist {
    font-size: 0.85rem;
    color: var(--text-light);
    margin-bottom: var(--spacing-md);
    font-weight: 500;
  }

  .description {
    font-size: 0.9rem;
    color: var(--text-light);
    margin-bottom: var(--spacing-md);
  }

  .read-more {
    font-size: 0.85rem;
    color: var(--text);
    font-weight: 600;
    transition: color 0.3s;
  }

  .read-more:hover {
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .releases-section {
      padding: var(--spacing-lg) var(--spacing-md);
    }

    h1 {
      font-size: 2rem;
    }

    .releases-grid {
      grid-template-columns: 1fr;
    }
  }
</style>